<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="События WPF" Height="200" Width="300"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="MainGrid">
        <TextBox x:Name="InputTextBox" Width="200" Height="30" Margin="50,30,50,0" VerticalAlignment="Top"/>
        <Button Content="Блокировать" Width="100" Height="30" Margin="30,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BlockButton_Click"/>
        <Button Content="Разблокировать" Width="100" Height="30" Margin="150,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="UnblockButton_Click"/>
    </Grid>
</Window>
