<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главное окно" Height="150" Width="800">
    <Grid Margin="0,0,0,-44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="671*"/>
            <ColumnDefinition Width="129*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                      Width="5" Background="Gray" ResizeBehavior="PreviousAndNext" Margin="124,0,0,0" />

        <Grid Grid.Row="0" Grid.Column="0" Margin="10,10,10,10" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="1" Click="OpenButton1_Click"
                    Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Width="Auto" HorizontalAlignment="Stretch" />

            <Button Content="2" Click="OpenButton2_Click"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Width="Auto" HorizontalAlignment="Stretch" />

            <Button Content="3" Click="OpenButton3_Click"
                    Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Width="Auto" HorizontalAlignment="Stretch" />

            <Button Content="4" Click="OpenButton4_Click"
                    Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Width="Auto" HorizontalAlignment="Stretch" />

            <Button Content="5" Click="OpenButton5_Click"
                    Grid.Row="4" Grid.Column="0" Width="Auto" HorizontalAlignment="Stretch" />

            <Button Content="6" Click="OpenButton6_Click"
                    Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Width="Auto" HorizontalAlignment="Stretch" />
        </Grid>

        <ContentControl Name="NewWindowArea" Grid.Row="0" Margin="10,10,10,176" Grid.ColumnSpan="2" />
    </Grid>
</Window>