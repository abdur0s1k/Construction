<Window x:Class="EmployeeCardApp.EmployeeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка сотрудника" Height="500" Width="500">
    <Grid Margin="10">
        <!-- Определение строк -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Фамилия -->
            <RowDefinition Height="Auto"/>
            <!-- Текстовое поле для фамилии -->
            <RowDefinition Height="Auto"/>
            <!-- Имя -->
            <RowDefinition Height="Auto"/>
            <!-- Текстовое поле для имени -->
            <RowDefinition Height="Auto"/>
            <!-- Отчество -->
            <RowDefinition Height="Auto"/>
            <!-- Текстовое поле для отчества -->
            <RowDefinition Height="Auto"/>
            <!-- Должность -->
            <RowDefinition Height="Auto"/>
            <!-- Текстовое поле для должности -->
            <RowDefinition Height="Auto"/>
            <!-- Отдел -->
            <RowDefinition Height="Auto"/>
            <!-- ComboBox для отдела -->
            <RowDefinition Height="Auto"/>
            <!-- Дата рождения -->
            <RowDefinition Height="Auto"/>
            <!-- DatePicker для даты рождения -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Определение колонок -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Ярлык -->
            <ColumnDefinition Width="*"/>
            <!-- Поле ввода -->
            <ColumnDefinition Width="Auto"/>
            <!-- Пустая колонка для отступа -->
            <ColumnDefinition Width="Auto"/>
            <!-- Кнопки -->
        </Grid.ColumnDefinitions>

        <!-- Фамилия -->
        <TextBlock Text="Фамилия:" Grid.Row="0" Grid.Column="0"/>
        <TextBox Name="TextBoxLastName" Grid.Row="1" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- Имя -->
        <TextBlock Text="Имя:" Grid.Row="2" Grid.Column="0"/>
        <TextBox Name="TextBoxFirstName" Grid.Row="3" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- Отчество -->
        <TextBlock Text="Отчество:" Grid.Row="4" Grid.Column="0"/>
        <TextBox Name="TextBoxMiddleName" Grid.Row="5" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- Должность -->
        <TextBlock Text="Должность:" Grid.Row="6" Grid.Column="0"/>
        <TextBox Name="TextBoxPosition" Grid.Row="7" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- Отдел -->
        <TextBlock Text="Отдел:" Grid.Row="8" Grid.Column="0"/>
        <ComboBox Name="ComboBoxDepartment" Grid.Row="9" Grid.Column="1" Margin="0,5,0,10">
            <!-- Предопределенные значения для отделов -->
            <ComboBoxItem>Отдел кадров</ComboBoxItem>
            <ComboBoxItem>Финансовый отдел</ComboBoxItem>
            <ComboBoxItem>Технический отдел</ComboBoxItem>
            <ComboBoxItem>Маркетинг</ComboBoxItem>
            <ComboBoxItem>Продажи</ComboBoxItem>
        </ComboBox>

        <!-- Дата рождения -->
        <TextBlock Text="Дата рождения:" Grid.Row="10" Grid.Column="0"/>
        <DatePicker Name="DatePickerBirthDate" Grid.Row="11" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="1" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Сбросить" Width="100" Margin="5" Click="ResetButton_Click"/>
        </StackPanel>
    </Grid>
</Window>