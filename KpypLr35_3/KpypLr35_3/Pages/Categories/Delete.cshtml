@page "{id:int}"
@model KpypLr35_3.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "🗑 Удалить категорию";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white fw-bold fs-5">
                    @ViewData["Title"]
                </div>
                <div class="card-body">
                    <h5 class="mb-3 text-center text-danger">
                        Вы уверены, что хотите удалить категорию:
                    </h5>
                    <h4 class="text-center mb-4">«@Model.Category.Name»</h4>

                    <form method="post" class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-danger px-4">
                            ✅ Да, удалить
                        </button>
                        <a asp-page="./Index" class="btn btn-secondary">
                            ❌ Отмена
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
