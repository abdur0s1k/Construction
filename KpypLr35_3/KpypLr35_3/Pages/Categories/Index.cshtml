@page
@model KpypLr35_3.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "📂 Категории";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a class="btn btn-success" asp-page="Create">➕ Добавить категорию</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Количество товаров</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Products.Count</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-page="Edit" asp-route-id="@c.Id">✏️ Изменить</a>
                                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@c.Id">🗑️ Удалить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
