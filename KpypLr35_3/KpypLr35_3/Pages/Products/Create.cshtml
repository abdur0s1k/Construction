@page
@model KpypLr35_3.Pages.Products.CreateModel
@{
    ViewData["Title"] = "✨ Добавить новый товар";
}

<div class="container py-5">
  <div class="card shadow-sm mx-auto" style="max-width: 600px;">
    <div class="card-body">
      <h2 class="card-title mb-4 text-center">@ViewData["Title"]</h2>

      <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-floating mb-3">
          <input asp-for="Product.Name" class="form-control" placeholder="Название товара" />
          <label asp-for="Product.Name">Название</label>
          <span asp-validation-for="Product.Name" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
          <input asp-for="Product.Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
          <label asp-for="Product.Price">Цена, ₽</label>
          <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Product.CategoryId" class="form-label">Категория</label>
          <select asp-for="Product.CategoryId" asp-items="Model.CategoryList" class="form-select">
            <option value="">— Выберите категорию —</option>
          </select>
          <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
          <button type="submit" class="btn btn-primary btn-lg px-5">Сохранить</button>
          <a asp-page="./Index" class="btn btn-outline-secondary btn-lg px-5">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
      <partial name="_ValidationScriptsPartial" />
}
