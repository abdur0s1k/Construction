@page "{id:int}"
@model KpypLr35_3.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "🗑️ Удалить товар";
}

<div class="container py-5">
    <div class="card border-danger shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header bg-danger text-white text-center fs-4">
            @ViewData["Title"]
        </div>

        <div class="card-body">
            <p class="text-center fs-5 text-danger fw-semibold">
                Вы уверены, что хотите удалить этот товар?
            </p>

            <hr />

            <dl class="row fs-5">
                <dt class="col-sm-4">📦 Название:</dt>
                <dd class="col-sm-8">@Model.Product.Name</dd>

                <dt class="col-sm-4">💰 Цена:</dt>
                <dd class="col-sm-8">@Model.Product.Price.ToString("C")</dd>

                <dt class="col-sm-4">🏷️ Категория:</dt>
                <dd class="col-sm-8">@Model.Product.Category?.Name</dd>
            </dl>

            <div class="text-center mt-4">
                <form method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-lg px-4">Удалить</button>
                </form>
                <a asp-page="Index" class="btn btn-outline-secondary btn-lg ms-3 px-4">Отмена</a>
            </div>
        </div>
    </div>
</div>
